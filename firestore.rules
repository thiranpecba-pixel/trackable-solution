// ══════════════════════════════════════════════════════
// Firebase Firestore Security Rules
// Trackable Solution — Ceylon Business Appliances
//
// Paste this into:
// Firebase Console → Firestore Database → Rules
// ══════════════════════════════════════════════════════

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: get the user's role from Firestore
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isCoordinator() { return isAuth() && getRole() == 'coordinator'; }
    function isDeveloper()   { return isAuth() && getRole() == 'developer'; }
    function isManagement()  { return isAuth() && getRole() == 'management'; }
    function isStaff()       { return isCoordinator() || isDeveloper(); }

    // ── Users collection ──
    // Coordinators can create/read users; all roles can read their own doc
    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isCoordinator());
      allow create: if isCoordinator();
      allow update: if isCoordinator();
      allow delete: if false; // Never delete via client
    }

    // ── Feedback collection ──
    // Coordinators can create & update status
    // Developers can update itReply, status
    // Management can only read
    match /feedback/{feedbackId} {
      allow read: if isAuth();
      allow create: if isCoordinator();
      allow update: if isStaff();
      allow delete: if false;
    }

    // ── Timeline collection ──
    // Coordinators can create & update
    // Everyone else can read
    match /timeline/{phaseId} {
      allow read: if isAuth();
      allow create, update: if isCoordinator();
      allow delete: if false;
    }
  }
}
